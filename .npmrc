# pnpm's default layout already prevents phantom dependencies: a file importing
# a package its own package.json does not declare fails here, rather than
# working by accident and breaking on the server. That is why pnpm, not npm.
#
# The two settings below are a different matter — they are only about PEER
# dependencies. React's ecosystem declares peers loosely, so auto-installing
# them and not failing on a range mismatch keeps the install usable. Revisit if
# a real version conflict ever hides behind this.
auto-install-peers=true
strict-peer-dependencies=false
