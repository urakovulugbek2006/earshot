{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Earshot design tokens. Direction C (Signal), Timurid palette. DTCG format — consumed by Style Dictionary to emit theme.css and mirrored as Figma variables. This file is the source of truth; never hardcode a colour in a component.",

  "primitive": {
    "$description": "Raw palette. Never reference these from a component — go through `semantic`. Hues are taken from the standard of Amir Temur and from Timurid tilework: turquoise, gold, terracotta, lapis.",
    "sand": {
      "$description": "Warm neutrals — the light theme's ground.",
      "50":   { "$type": "color", "$value": "#FDFCFA" },
      "100":  { "$type": "color", "$value": "#F6F4EF" },
      "200":  { "$type": "color", "$value": "#EDEAE0" },
      "300":  { "$type": "color", "$value": "#D6D3CA" },
      "600":  { "$type": "color", "$value": "#5C5A54" },
      "700":  { "$type": "color", "$value": "#413F39" }
    },
    "slate": {
      "$description": "Cool neutrals — the dark theme's ground. Cooled from sand so it sits under turquoise without going muddy.",
      "100":  { "$type": "color", "$value": "#F2F4F3" },
      "200":  { "$type": "color", "$value": "#E4EAE9" },
      "300":  { "$type": "color", "$value": "#CBD2D1" },
      "400":  { "$type": "color", "$value": "#9AA3A3" },
      "700":  { "$type": "color", "$value": "#2A3438" },
      "800":  { "$type": "color", "$value": "#172025" },
      "900":  { "$type": "color", "$value": "#0F1417" },
      "1000": { "$type": "color", "$value": "#0A0F11" }
    },
    "ink":   { "$type": "color", "$value": "#141413", "$description": "The border and text black." },
    "white": { "$type": "color", "$value": "#FFFFFF" },
    "turquoise": {
      "$description": "The ko'k of the Timurid standard — the same blue the flag of Uzbekistan takes from it. 500 is the brand colour.",
      "100": { "$type": "color", "$value": "#C9EDF3" },
      "500": { "$type": "color", "$value": "#0099B5" },
      "700": { "$type": "color", "$value": "#00707F" },
      "300": { "$type": "color", "$value": "#22C3DB" },
      "200": { "$type": "color", "$value": "#6FE0F0" },
      "900": { "$type": "color", "$value": "#0A1416" },
      "950": { "$type": "color", "$value": "#06161A" },
      "800": { "$type": "color", "$value": "#0E3A44" }
    },
    "gold":       { "500": { "$type": "color", "$value": "#F3C84E" } },
    "terracotta": {
      "400": { "$type": "color", "$value": "#F07A52" },
      "500": { "$type": "color", "$value": "#D9542B" }
    },
    "lapis": {
      "300": { "$type": "color", "$value": "#7A95E8" },
      "500": { "$type": "color", "$value": "#2B4C9B" }
    }
  },

  "semantic": {
    "$description": "What a colour is FOR. Components reference only these. Each has a light and a dark value; the build emits both under a [data-theme] selector.",

    "light": {
      "bg": {
        "base":    { "$type": "color", "$value": "{primitive.sand.100}" },
        "surface": { "$type": "color", "$value": "{primitive.white}" },
        "sunken":  { "$type": "color", "$value": "{primitive.sand.200}" }
      },
      "text": {
        "primary":     { "$type": "color", "$value": "{primitive.ink}",      "$description": "15:1 on bg.base" },
        "secondary":   { "$type": "color", "$value": "{primitive.sand.700}", "$description": "8:1 on bg.base" },
        "muted":       { "$type": "color", "$value": "{primitive.sand.600}", "$description": "6.5:1 on bg.base — the floor. Nothing lighter carries text." },
        "onAccent":    { "$type": "color", "$value": "{primitive.turquoise.900}", "$description": "Near-black. White on turquoise.500 is only 3.37:1 and is forbidden." },
        "onHighlight": { "$type": "color", "$value": "{primitive.ink}" }
      },
      "border": {
        "strong": { "$type": "color", "$value": "{primitive.ink}",      "$description": "The signature 2px border, on nearly every surface." },
        "subtle": { "$type": "color", "$value": "{primitive.sand.300}", "$description": "Dividers only, never a container edge." }
      },
      "accent": {
        "default": { "$type": "color", "$value": "{primitive.turquoise.500}", "$description": "A FILL only. Carries near-black text." },
        "text":    { "$type": "color", "$value": "{primitive.turquoise.700}", "$description": "For links and small text — 5.8:1 on bg.base, where accent.default would fail." },
        "soft":    { "$type": "color", "$value": "{primitive.turquoise.100}", "$description": "Tinted panels; carries primary text." }
      },
      "status": {
        "highlight": { "$type": "color", "$value": "{primitive.gold.500}",       "$description": "In-sync indicator, live room header. Carries dark text." },
        "warn":      { "$type": "color", "$value": "{primitive.terracotta.500}" },
        "info":      { "$type": "color", "$value": "{primitive.lapis.500}" }
      },
      "shadow":   { "hard": { "$type": "color", "$value": "{primitive.ink}" } },
      "waveform": {
        "played":    { "$type": "color", "$value": "{primitive.turquoise.500}" },
        "remaining": { "$type": "color", "$value": "{primitive.sand.300}" }
      }
    },

    "dark": {
      "$description": "Not an inversion. border.strong flips to a LIGHT value so the 2px edges still read as edges; accent lightens because turquoise.500 drops to ~3.1:1 on a dark ground; and the ground itself cools from sand to slate to sit under the turquoise.",
      "bg": {
        "base":    { "$type": "color", "$value": "{primitive.slate.900}" },
        "surface": { "$type": "color", "$value": "{primitive.slate.800}" },
        "sunken":  { "$type": "color", "$value": "{primitive.slate.1000}" }
      },
      "text": {
        "primary":     { "$type": "color", "$value": "{primitive.slate.100}", "$description": "16:1 on bg.base" },
        "secondary":   { "$type": "color", "$value": "{primitive.slate.300}" },
        "muted":       { "$type": "color", "$value": "{primitive.slate.400}", "$description": "8:1 on bg.base" },
        "onAccent":    { "$type": "color", "$value": "{primitive.turquoise.950}" },
        "onHighlight": { "$type": "color", "$value": "{primitive.ink}" }
      },
      "border": {
        "strong": { "$type": "color", "$value": "{primitive.slate.200}" },
        "subtle": { "$type": "color", "$value": "{primitive.slate.700}" }
      },
      "accent": {
        "default": { "$type": "color", "$value": "{primitive.turquoise.300}", "$description": "8.9:1 on bg.base" },
        "text":    { "$type": "color", "$value": "{primitive.turquoise.200}" },
        "soft":    { "$type": "color", "$value": "{primitive.turquoise.800}" }
      },
      "status": {
        "highlight": { "$type": "color", "$value": "{primitive.gold.500}", "$description": "Unchanged across themes — it carries dark text in both, and it is the sync indicator, so it should look identical either way." },
        "warn":      { "$type": "color", "$value": "{primitive.terracotta.400}" },
        "info":      { "$type": "color", "$value": "{primitive.lapis.300}" }
      },
      "shadow":   { "hard": { "$type": "color", "$value": "{primitive.slate.200}" } },
      "waveform": {
        "played":    { "$type": "color", "$value": "{primitive.turquoise.300}" },
        "remaining": { "$type": "color", "$value": "{primitive.slate.700}" }
      }
    }
  },

  "font": {
    "family": { "sans": { "$type": "fontFamily", "$value": ["Archivo", "system-ui", "sans-serif"] } },
    "weight": {
      "regular":  { "$type": "fontWeight", "$value": 400 },
      "medium":   { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold":     { "$type": "fontWeight", "$value": 700 },
      "black":    { "$type": "fontWeight", "$value": 800 }
    }
  },

  "typography": {
    "$description": "Named roles, not sizes. A component asks for `display.lg`, never `50px`.",
    "display": {
      "lg": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontSize": "50px", "lineHeight": "0.96", "fontWeight": "{font.weight.black}", "letterSpacing": "-0.035em" } },
      "md": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontSize": "36px", "lineHeight": "1.0",  "fontWeight": "{font.weight.black}", "letterSpacing": "-0.03em" } }
    },
    "heading": {
      "lg": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontSize": "20px", "lineHeight": "1.2",  "fontWeight": "{font.weight.black}",    "letterSpacing": "-0.02em" } },
      "md": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontSize": "16px", "lineHeight": "1.3",  "fontWeight": "{font.weight.bold}",     "letterSpacing": "-0.01em" } },
      "sm": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontSize": "14px", "lineHeight": "1.35", "fontWeight": "{font.weight.semibold}", "letterSpacing": "0" } }
    },
    "body": {
      "lg": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontSize": "16px",   "lineHeight": "1.5",  "fontWeight": "{font.weight.regular}", "letterSpacing": "0" } },
      "md": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontSize": "13.5px", "lineHeight": "1.5",  "fontWeight": "{font.weight.regular}", "letterSpacing": "0" } },
      "sm": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontSize": "12px",   "lineHeight": "1.45", "fontWeight": "{font.weight.regular}", "letterSpacing": "0" } }
    },
    "label": {
      "$description": "Uppercase eyebrow labels. 11px is only legible in this treatment because weight is 700 and tracking is wide — do not reuse the size elsewhere.",
      "md": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontSize": "11px", "lineHeight": "1.2", "fontWeight": "{font.weight.bold}", "letterSpacing": "0.1em", "textTransform": "uppercase" } }
    }
  },

  "space": {
    "$description": "4px base. Use the scale, never an arbitrary pixel value.",
    "0":  { "$type": "dimension", "$value": "0px" },
    "1":  { "$type": "dimension", "$value": "4px" },
    "2":  { "$type": "dimension", "$value": "8px" },
    "3":  { "$type": "dimension", "$value": "12px" },
    "4":  { "$type": "dimension", "$value": "16px" },
    "5":  { "$type": "dimension", "$value": "20px" },
    "6":  { "$type": "dimension", "$value": "24px" },
    "8":  { "$type": "dimension", "$value": "32px" },
    "10": { "$type": "dimension", "$value": "40px" },
    "12": { "$type": "dimension", "$value": "48px" },
    "16": { "$type": "dimension", "$value": "64px" }
  },

  "radius": {
    "$description": "Deliberately tiny set. Direction C is sharp — a rounded corner is an exception, not a default.",
    "none": { "$type": "dimension", "$value": "0px" },
    "sm":   { "$type": "dimension", "$value": "2px" },
    "full": { "$type": "dimension", "$value": "9999px", "$description": "Status dots and avatars only" }
  },

  "borderWidth": {
    "hair":    { "$type": "dimension", "$value": "1px" },
    "default": { "$type": "dimension", "$value": "2px", "$description": "The signature. If in doubt, 2px." },
    "thick":   { "$type": "dimension", "$value": "3px" }
  },

  "shadow": {
    "$description": "Hard offset, zero blur. No soft shadows anywhere in this system — that is the whole visual thesis.",
    "hard": {
      "sm": { "$type": "shadow", "$value": { "offsetX": "4px", "offsetY": "4px", "blur": "0px", "spread": "0px", "color": "{semantic.light.shadow.hard}" } },
      "md": { "$type": "shadow", "$value": { "offsetX": "7px", "offsetY": "7px", "blur": "0px", "spread": "0px", "color": "{semantic.light.shadow.hard}" } }
    }
  },

  "motion": {
    "duration": {
      "fast": { "$type": "duration", "$value": "120ms" },
      "base": { "$type": "duration", "$value": "200ms" },
      "slow": { "$type": "duration", "$value": "320ms" }
    },
    "easing": {
      "standard":   { "$type": "cubicBezier", "$value": [0.2, 0, 0.2, 1] },
      "decelerate": { "$type": "cubicBezier", "$value": [0, 0, 0.2, 1] }
    }
  },

  "size": {
    "touchTarget": { "$type": "dimension", "$value": "44px", "$description": "WCAG 2.1 AA minimum. Every interactive element meets this, icon-only transport buttons included." }
  }
}
