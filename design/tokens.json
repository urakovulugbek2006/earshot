{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Earshot design tokens. Instrument language (direction A's look) on the rooms-first information architecture. Dark is the primary theme; light is secondary. DTCG format — consumed by Style Dictionary to emit theme.css and mirrored as Figma variables. This file is the source of truth; never hardcode a colour in a component.",

  "primitive": {
    "$description": "Raw palette. Never reference these from a component — go through `semantic`.",
    "graphite": {
      "$description": "The dark theme's ground. Neutral, very slightly cool, so magenta sits on it cleanly.",
      "100":  { "$type": "color", "$value": "#EDEDF2" },
      "300":  { "$type": "color", "$value": "#B4B4C0" },
      "500":  { "$type": "color", "$value": "#85858F" },
      "600":  { "$type": "color", "$value": "#3A3A44" },
      "700":  { "$type": "color", "$value": "#24242B" },
      "800":  { "$type": "color", "$value": "#1D1D24" },
      "850":  { "$type": "color", "$value": "#17171C" },
      "900":  { "$type": "color", "$value": "#121216" },
      "950":  { "$type": "color", "$value": "#0B0B0D" },
      "1000": { "$type": "color", "$value": "#08080A" }
    },
    "paper": {
      "$description": "The light theme's ground.",
      "0":   { "$type": "color", "$value": "#FFFFFF" },
      "50":  { "$type": "color", "$value": "#F7F7F8" },
      "100": { "$type": "color", "$value": "#F1F1F3" },
      "200": { "$type": "color", "$value": "#ECECEF" },
      "300": { "$type": "color", "$value": "#E2E2E6" },
      "400": { "$type": "color", "$value": "#C8C8D0" },
      "600": { "$type": "color", "$value": "#6E6E7A" },
      "700": { "$type": "color", "$value": "#4A4A55" },
      "900": { "$type": "color", "$value": "#15151A" }
    },
    "magenta": {
      "$description": "The brand, reserved for actions. 300 on the dark ground, 500 on the light one — the dark value has to be lighter because 500 measures only 3.27:1 against graphite.950.",
      "100": { "$type": "color", "$value": "#FBE4ED" },
      "300": { "$type": "color", "$value": "#FF2E7E" },
      "500": { "$type": "color", "$value": "#C2185B" },
      "900": { "$type": "color", "$value": "#2A0F1C" }
    },
    "gold": {
      "$description": "Means LIVE. 500 on dark; 700 for text on light, where 500 is only 1.7:1 and unusable.",
      "500": { "$type": "color", "$value": "#F3C84E" },
      "700": { "$type": "color", "$value": "#8A6A08" }
    },
    "amber": {
      "500": { "$type": "color", "$value": "#E0953A" },
      "600": { "$type": "color", "$value": "#B45309" }
    },
    "indigo": {
      "400": { "$type": "color", "$value": "#7A8CF0" },
      "500": { "$type": "color", "$value": "#4338CA" }
    },
    "red": { "500": { "$type": "color", "$value": "#F0564A" } }
  },

  "semantic": {
    "$description": "What a colour is FOR. Components reference only these. Dark is the default theme; light is emitted under a [data-theme] selector.",

    "dark": {
      "$description": "The primary theme.",
      "bg": {
        "base":    { "$type": "color", "$value": "{primitive.graphite.950}" },
        "surface": { "$type": "color", "$value": "{primitive.graphite.900}" },
        "raised":  { "$type": "color", "$value": "{primitive.graphite.850}" },
        "sunken":  { "$type": "color", "$value": "{primitive.graphite.1000}" }
      },
      "text": {
        "primary":   { "$type": "color", "$value": "{primitive.graphite.100}", "$description": "~17:1 on bg.base" },
        "secondary": { "$type": "color", "$value": "{primitive.graphite.300}" },
        "muted":     { "$type": "color", "$value": "{primitive.graphite.500}", "$description": "5.3:1 on bg.base — the floor. Nothing dimmer carries text." },
        "onAccent":  { "$type": "color", "$value": "{primitive.graphite.950}", "$description": "Near-black on the lifted magenta, 5.5:1." }
      },
      "border": {
        "hair":   { "$type": "color", "$value": "{primitive.graphite.700}", "$description": "The signature 1px hairline. Default for every panel, row and input." },
        "strong": { "$type": "color", "$value": "{primitive.graphite.600}", "$description": "Emphasis only — table heads, focused controls." }
      },
      "accent": {
        "default": { "$type": "color", "$value": "{primitive.magenta.300}", "$description": "Actions only. 5.5:1 on bg.base, so it works as fill AND as text." },
        "soft":    { "$type": "color", "$value": "{primitive.magenta.900}" }
      },
      "status": {
        "live":  { "$type": "color", "$value": "{primitive.gold.500}" },
        "warn":  { "$type": "color", "$value": "{primitive.amber.500}" },
        "error": { "$type": "color", "$value": "{primitive.red.500}" },
        "info":  { "$type": "color", "$value": "{primitive.indigo.400}" }
      },
      "waveform": {
        "played":    { "$type": "color", "$value": "{primitive.magenta.300}" },
        "remaining": { "$type": "color", "$value": "{primitive.graphite.800}" }
      }
    },

    "light": {
      "$description": "Secondary theme. Not an inversion: the accent darkens rather than lightens, and gold moves to its 700 value because 500 is unreadable on paper.",
      "bg": {
        "base":    { "$type": "color", "$value": "{primitive.paper.50}" },
        "surface": { "$type": "color", "$value": "{primitive.paper.0}" },
        "raised":  { "$type": "color", "$value": "{primitive.paper.100}" },
        "sunken":  { "$type": "color", "$value": "{primitive.paper.200}" }
      },
      "text": {
        "primary":   { "$type": "color", "$value": "{primitive.paper.900}" },
        "secondary": { "$type": "color", "$value": "{primitive.paper.700}" },
        "muted":     { "$type": "color", "$value": "{primitive.paper.600}", "$description": "5.4:1 on bg.base — the floor." },
        "onAccent":  { "$type": "color", "$value": "{primitive.paper.0}", "$description": "White on magenta.500, 5.9:1." }
      },
      "border": {
        "hair":   { "$type": "color", "$value": "{primitive.paper.300}" },
        "strong": { "$type": "color", "$value": "{primitive.paper.400}" }
      },
      "accent": {
        "default": { "$type": "color", "$value": "{primitive.magenta.500}" },
        "soft":    { "$type": "color", "$value": "{primitive.magenta.100}" }
      },
      "status": {
        "live":  { "$type": "color", "$value": "{primitive.gold.700}" },
        "warn":  { "$type": "color", "$value": "{primitive.amber.600}" },
        "error": { "$type": "color", "$value": "{primitive.red.500}" },
        "info":  { "$type": "color", "$value": "{primitive.indigo.500}" }
      },
      "waveform": {
        "played":    { "$type": "color", "$value": "{primitive.magenta.500}" },
        "remaining": { "$type": "color", "$value": "{primitive.paper.300}" }
      }
    }
  },

  "font": {
    "family": {
      "sans": { "$type": "fontFamily", "$value": ["Inter", "system-ui", "sans-serif"] },
      "mono": { "$type": "fontFamily", "$value": ["JetBrains Mono", "ui-monospace", "monospace"], "$description": "Every number in the product: BPM, key, timecode, milliseconds, LUFS, counts, percentages. Not decoration — tabular figures keep columns aligned and make a changing value legible at a glance." }
    },
    "weight": {
      "regular":  { "$type": "fontWeight", "$value": 400 },
      "medium":   { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold":     { "$type": "fontWeight", "$value": 700 }
    }
  },

  "typography": {
    "display": {
      "lg": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontSize": "50px", "lineHeight": "1.0",  "fontWeight": "{font.weight.semibold}", "letterSpacing": "-0.035em" } },
      "md": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontSize": "38px", "lineHeight": "1.04", "fontWeight": "{font.weight.semibold}", "letterSpacing": "-0.03em" } }
    },
    "heading": {
      "lg": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontSize": "22px", "lineHeight": "1.2",  "fontWeight": "{font.weight.semibold}", "letterSpacing": "-0.025em" } },
      "md": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontSize": "16px", "lineHeight": "1.3",  "fontWeight": "{font.weight.semibold}", "letterSpacing": "-0.015em" } }
    },
    "body": {
      "md": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontSize": "13px",   "lineHeight": "1.55", "fontWeight": "{font.weight.regular}", "letterSpacing": "0" } },
      "sm": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontSize": "11.5px", "lineHeight": "1.5",  "fontWeight": "{font.weight.regular}", "letterSpacing": "0" } }
    },
    "data": {
      "$description": "Numeric readouts. Always mono.",
      "lg": { "$type": "typography", "$value": { "fontFamily": "{font.family.mono}", "fontSize": "20px",   "lineHeight": "1.1", "fontWeight": "{font.weight.bold}",    "letterSpacing": "0" } },
      "md": { "$type": "typography", "$value": { "fontFamily": "{font.family.mono}", "fontSize": "11.5px", "lineHeight": "1.3", "fontWeight": "{font.weight.regular}", "letterSpacing": "0" } }
    },
    "label": {
      "$description": "Mono micro-labels. 9.5px is only legible because tracking is very wide and they are always uppercase.",
      "md": { "$type": "typography", "$value": { "fontFamily": "{font.family.mono}", "fontSize": "9.5px", "lineHeight": "1.2", "fontWeight": "{font.weight.medium}", "letterSpacing": "0.13em", "textTransform": "uppercase" } }
    }
  },

  "space": {
    "1":  { "$type": "dimension", "$value": "4px" },
    "2":  { "$type": "dimension", "$value": "8px" },
    "3":  { "$type": "dimension", "$value": "12px" },
    "4":  { "$type": "dimension", "$value": "16px" },
    "5":  { "$type": "dimension", "$value": "20px" },
    "6":  { "$type": "dimension", "$value": "24px" },
    "8":  { "$type": "dimension", "$value": "32px" },
    "10": { "$type": "dimension", "$value": "40px" },
    "12": { "$type": "dimension", "$value": "48px" }
  },

  "radius": {
    "none": { "$type": "dimension", "$value": "0px" },
    "sm":   { "$type": "dimension", "$value": "3px", "$description": "The default. Enough to read as a control, not enough to read as a bubble." },
    "full": { "$type": "dimension", "$value": "9999px", "$description": "Status dots and the primary transport button only." }
  },

  "borderWidth": {
    "hair":  { "$type": "dimension", "$value": "1px", "$description": "The signature. If in doubt, 1px." },
    "focus": { "$type": "dimension", "$value": "2px", "$description": "Focus rings only." }
  },

  "shadow": {
    "$description": "There are no shadows in this system. Depth comes from the ground/surface/raised steps and from hairlines. A box-shadow in a component is a bug."
  },

  "motion": {
    "duration": {
      "fast": { "$type": "duration", "$value": "120ms" },
      "base": { "$type": "duration", "$value": "200ms" }
    },
    "easing": {
      "standard": { "$type": "cubicBezier", "$value": [0.2, 0, 0.2, 1] }
    }
  },

  "size": {
    "control":     { "$type": "dimension", "$value": "36px", "$description": "Dense controls in the nav and room strip. Sits inside a 44px hit area." },
    "touchTarget": { "$type": "dimension", "$value": "44px", "$description": "WCAG 2.1 AA minimum. Every interactive element meets this, by padding where the visual control is smaller." }
  }
}
