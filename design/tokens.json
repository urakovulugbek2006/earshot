{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Earshot design tokens. Violet accent on accent-tinted grounds, on the rooms-first information architecture. Night is the primary theme; light is secondary. DTCG format. This file is the source of truth; never hardcode a colour in a component.",
  "primitive": {
    "$description": "Raw palette. Never reference these from a component — go through `semantic`. Both neutral ramps are TINTED with the accent hue rather than left grey: in the light theme nothing is pure #FFFFFF, not even a card surface. That tint is what separates a light UI that was decided from one that was defaulted.",
    "graphite": {
      "$description": "Night ground, carrying a trace of the violet accent (RGB spread 5–12, hue ~247°).",
      "100": {
        "$type": "color",
        "$value": "#EEEDF3"
      },
      "300": {
        "$type": "color",
        "$value": "#C4C1D2"
      },
      "500": {
        "$type": "color",
        "$value": "#8B8799",
        "$description": "5.7:1 on bg.base — the floor"
      },
      "600": {
        "$type": "color",
        "$value": "#383545"
      },
      "700": {
        "$type": "color",
        "$value": "#262430"
      },
      "800": {
        "$type": "color",
        "$value": "#232130"
      },
      "850": {
        "$type": "color",
        "$value": "#1A1824"
      },
      "900": {
        "$type": "color",
        "$value": "#14131C"
      },
      "950": {
        "$type": "color",
        "$value": "#0A0A0F"
      },
      "1000": {
        "$type": "color",
        "$value": "#060609"
      }
    },
    "paper": {
      "$description": "Light ground, violet-tinted. `0` is the card surface and is deliberately NOT pure white.",
      "0": {
        "$type": "color",
        "$value": "#FBFAFE",
        "$description": "Card surface. Not #FFFFFF."
      },
      "50": {
        "$type": "color",
        "$value": "#F4F2F9"
      },
      "100": {
        "$type": "color",
        "$value": "#EEEBF6"
      },
      "200": {
        "$type": "color",
        "$value": "#E5E1F0"
      },
      "300": {
        "$type": "color",
        "$value": "#DDD8EC"
      },
      "400": {
        "$type": "color",
        "$value": "#C3BBD9"
      },
      "600": {
        "$type": "color",
        "$value": "#68617C",
        "$description": "5.3:1 on bg.base — the floor"
      },
      "700": {
        "$type": "color",
        "$value": "#474156"
      },
      "900": {
        "$type": "color",
        "$value": "#16131F"
      }
    },
    "white": {
      "$type": "color",
      "$value": "#FFFFFF",
      "$description": "Only ever text or an icon ON the accent. Never a surface."
    },
    "violet": {
      "$description": "The brand, reserved for actions. 700 on light at 6.4:1, 300 on night at 7.3:1. Chosen over teal and magenta because it separates from the gold LIVE colour by 149° of hue AND a 1.71 lightness ratio, so the pair survives greyscale and colour blindness.",
      "100": {
        "$type": "color",
        "$value": "#E9DDFD"
      },
      "200": {
        "$type": "color",
        "$value": "#D8C8FB"
      },
      "300": {
        "$type": "color",
        "$value": "#A78BFA"
      },
      "700": {
        "$type": "color",
        "$value": "#6D28D9"
      },
      "900": {
        "$type": "color",
        "$value": "#241B3D"
      },
      "950": {
        "$type": "color",
        "$value": "#16102B"
      }
    },
    "gold": {
      "$description": "Means LIVE. The light value is darker than a plain-white theme would need, because tinting the ground cost contrast: #8A6A08 measured 4.56:1 on it, too thin for 9.5px mono.",
      "500": {
        "$type": "color",
        "$value": "#F3C84E",
        "$description": "night · 12.4:1"
      },
      "800": {
        "$type": "color",
        "$value": "#75590A",
        "$description": "light · 5.9:1"
      }
    },
    "amber": {
      "500": {
        "$type": "color",
        "$value": "#E0953A",
        "$description": "night · 8.0:1"
      },
      "700": {
        "$type": "color",
        "$value": "#97440A",
        "$description": "light · 6.0:1"
      }
    },
    "blue": {
      "$description": "Tertiary fills. Was indigo until the accent became violet — the two collided, so the tertiary moved. A palette change is never only the accent.",
      "300": {
        "$type": "color",
        "$value": "#7AA2F0",
        "$description": "night"
      },
      "500": {
        "$type": "color",
        "$value": "#1D4ED8",
        "$description": "light"
      }
    },
    "red": {
      "500": {
        "$type": "color",
        "$value": "#F0564A",
        "$description": "night"
      },
      "700": {
        "$type": "color",
        "$value": "#B8352B",
        "$description": "light"
      }
    }
  },
  "semantic": {
    "$description": "What a colour is FOR. Components reference only these. Dark is the default theme; light is emitted under a [data-theme] selector.",
    "dark": {
      "$description": "The primary theme.",
      "bg": {
        "base": {
          "$type": "color",
          "$value": "{primitive.graphite.950}"
        },
        "surface": {
          "$type": "color",
          "$value": "{primitive.graphite.900}"
        },
        "raised": {
          "$type": "color",
          "$value": "{primitive.graphite.850}"
        },
        "sunken": {
          "$type": "color",
          "$value": "{primitive.graphite.1000}"
        }
      },
      "text": {
        "primary": {
          "$type": "color",
          "$value": "{primitive.graphite.100}",
          "$description": "~17:1 on bg.base"
        },
        "secondary": {
          "$type": "color",
          "$value": "{primitive.graphite.300}"
        },
        "muted": {
          "$type": "color",
          "$value": "{primitive.graphite.500}",
          "$description": "5.3:1 on bg.base — the floor. Nothing dimmer carries text."
        },
        "onAccent": {
          "$type": "color",
          "$value": "{primitive.violet.950}",
          "$description": "Near-black violet on the accent, 6.8:1."
        }
      },
      "border": {
        "hair": {
          "$type": "color",
          "$value": "{primitive.graphite.700}",
          "$description": "The signature 1px hairline. Default for every panel, row and input."
        },
        "strong": {
          "$type": "color",
          "$value": "{primitive.graphite.600}",
          "$description": "Emphasis only — table heads, focused controls."
        }
      },
      "accent": {
        "default": {
          "$type": "color",
          "$value": "{primitive.violet.300}",
          "$description": "Actions only. 7.3:1 on bg.base — fill, text, or hairline accent."
        },
        "soft": {
          "$type": "color",
          "$value": "{primitive.violet.900}"
        }
      },
      "status": {
        "live": {
          "$type": "color",
          "$value": "{primitive.gold.500}"
        },
        "warn": {
          "$type": "color",
          "$value": "{primitive.amber.500}"
        },
        "error": {
          "$type": "color",
          "$value": "{primitive.red.500}"
        },
        "info": {
          "$type": "color",
          "$value": "{primitive.blue.300}"
        }
      },
      "waveform": {
        "played": {
          "$type": "color",
          "$value": "{primitive.violet.300}"
        },
        "remaining": {
          "$type": "color",
          "$value": "{primitive.graphite.800}"
        }
      }
    },
    "light": {
      "$description": "Secondary theme. Not an inversion: the accent DARKENS to violet.700, and gold/amber move to darker values because the tinted ground costs contrast.",
      "bg": {
        "base": {
          "$type": "color",
          "$value": "{primitive.paper.50}"
        },
        "surface": {
          "$type": "color",
          "$value": "{primitive.paper.0}"
        },
        "raised": {
          "$type": "color",
          "$value": "{primitive.paper.100}"
        },
        "sunken": {
          "$type": "color",
          "$value": "{primitive.paper.200}"
        }
      },
      "text": {
        "primary": {
          "$type": "color",
          "$value": "{primitive.paper.900}"
        },
        "secondary": {
          "$type": "color",
          "$value": "{primitive.paper.700}"
        },
        "muted": {
          "$type": "color",
          "$value": "{primitive.paper.600}",
          "$description": "5.4:1 on bg.base — the floor."
        },
        "onAccent": {
          "$type": "color",
          "$value": "{primitive.white}",
          "$description": "White on violet.700, 7.1:1."
        }
      },
      "border": {
        "hair": {
          "$type": "color",
          "$value": "{primitive.paper.300}"
        },
        "strong": {
          "$type": "color",
          "$value": "{primitive.paper.400}"
        }
      },
      "accent": {
        "default": {
          "$type": "color",
          "$value": "{primitive.violet.700}"
        },
        "soft": {
          "$type": "color",
          "$value": "{primitive.violet.100}"
        }
      },
      "status": {
        "live": {
          "$type": "color",
          "$value": "{primitive.gold.800}"
        },
        "warn": {
          "$type": "color",
          "$value": "{primitive.amber.700}"
        },
        "error": {
          "$type": "color",
          "$value": "{primitive.red.700}"
        },
        "info": {
          "$type": "color",
          "$value": "{primitive.blue.500}"
        }
      },
      "waveform": {
        "played": {
          "$type": "color",
          "$value": "{primitive.violet.700}"
        },
        "remaining": {
          "$type": "color",
          "$value": "{primitive.paper.300}"
        }
      }
    }
  },
  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": [
          "Inter",
          "system-ui",
          "sans-serif"
        ]
      },
      "mono": {
        "$type": "fontFamily",
        "$value": [
          "JetBrains Mono",
          "ui-monospace",
          "monospace"
        ],
        "$description": "Every number in the product: BPM, key, timecode, milliseconds, LUFS, counts, percentages. Not decoration — tabular figures keep columns aligned and make a changing value legible at a glance."
      }
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "medium": {
        "$type": "fontWeight",
        "$value": 500
      },
      "semibold": {
        "$type": "fontWeight",
        "$value": 600
      },
      "bold": {
        "$type": "fontWeight",
        "$value": 700
      }
    }
  },
  "typography": {
    "display": {
      "lg": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "50px",
          "lineHeight": "1.0",
          "fontWeight": "{font.weight.semibold}",
          "letterSpacing": "-0.035em"
        }
      },
      "md": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "38px",
          "lineHeight": "1.04",
          "fontWeight": "{font.weight.semibold}",
          "letterSpacing": "-0.03em"
        }
      }
    },
    "heading": {
      "lg": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "22px",
          "lineHeight": "1.2",
          "fontWeight": "{font.weight.semibold}",
          "letterSpacing": "-0.025em"
        }
      },
      "md": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "16px",
          "lineHeight": "1.3",
          "fontWeight": "{font.weight.semibold}",
          "letterSpacing": "-0.015em"
        }
      }
    },
    "body": {
      "md": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "13px",
          "lineHeight": "1.55",
          "fontWeight": "{font.weight.regular}",
          "letterSpacing": "0"
        }
      },
      "sm": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "11.5px",
          "lineHeight": "1.5",
          "fontWeight": "{font.weight.regular}",
          "letterSpacing": "0"
        }
      }
    },
    "data": {
      "$description": "Numeric readouts. Always mono.",
      "lg": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.mono}",
          "fontSize": "20px",
          "lineHeight": "1.1",
          "fontWeight": "{font.weight.bold}",
          "letterSpacing": "0"
        }
      },
      "md": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.mono}",
          "fontSize": "11.5px",
          "lineHeight": "1.3",
          "fontWeight": "{font.weight.regular}",
          "letterSpacing": "0"
        }
      }
    },
    "label": {
      "$description": "Mono micro-labels. 9.5px is only legible because tracking is very wide and they are always uppercase.",
      "md": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.mono}",
          "fontSize": "9.5px",
          "lineHeight": "1.2",
          "fontWeight": "{font.weight.medium}",
          "letterSpacing": "0.13em",
          "textTransform": "uppercase"
        }
      }
    }
  },
  "space": {
    "1": {
      "$type": "dimension",
      "$value": "4px"
    },
    "2": {
      "$type": "dimension",
      "$value": "8px"
    },
    "3": {
      "$type": "dimension",
      "$value": "12px"
    },
    "4": {
      "$type": "dimension",
      "$value": "16px"
    },
    "5": {
      "$type": "dimension",
      "$value": "20px"
    },
    "6": {
      "$type": "dimension",
      "$value": "24px"
    },
    "8": {
      "$type": "dimension",
      "$value": "32px"
    },
    "10": {
      "$type": "dimension",
      "$value": "40px"
    },
    "12": {
      "$type": "dimension",
      "$value": "48px"
    }
  },
  "radius": {
    "none": {
      "$type": "dimension",
      "$value": "0px"
    },
    "sm": {
      "$type": "dimension",
      "$value": "3px",
      "$description": "The default. Enough to read as a control, not enough to read as a bubble."
    },
    "full": {
      "$type": "dimension",
      "$value": "9999px",
      "$description": "Status dots and the primary transport button only."
    }
  },
  "borderWidth": {
    "hair": {
      "$type": "dimension",
      "$value": "1px",
      "$description": "The signature. If in doubt, 1px."
    },
    "focus": {
      "$type": "dimension",
      "$value": "2px",
      "$description": "Focus rings only."
    }
  },
  "shadow": {
    "$description": "There are no shadows in this system. Depth comes from the ground/surface/raised steps and from hairlines. A box-shadow in a component is a bug."
  },
  "motion": {
    "duration": {
      "fast": {
        "$type": "duration",
        "$value": "120ms"
      },
      "base": {
        "$type": "duration",
        "$value": "200ms"
      }
    },
    "easing": {
      "standard": {
        "$type": "cubicBezier",
        "$value": [
          0.2,
          0,
          0.2,
          1
        ]
      }
    }
  },
  "size": {
    "control": {
      "$type": "dimension",
      "$value": "36px",
      "$description": "Dense controls in the nav and room strip. Sits inside a 44px hit area."
    },
    "touchTarget": {
      "$type": "dimension",
      "$value": "44px",
      "$description": "WCAG 2.1 AA minimum. Every interactive element meets this, by padding where the visual control is smaller."
    }
  }
}
