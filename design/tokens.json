{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Earshot design tokens. Violet accent on VIOLET grounds — the system contains no white at all, in either theme. Rooms-first information architecture. Night is the primary theme; light is secondary. DTCG format. This file is the source of truth; never hardcode a colour in a component.",
  "primitive": {
    "$description": "Raw palette. Never reference these from a component — go through `semantic`. Both ramps are violet, not neutral: the light ground is lavender #E6DEF7 and its lightest surface is #F1EBFB. There is no pure white token, on purpose — an earlier version tinted the grounds so faintly (RGB spread 7) that they read as white, which is the failure this palette exists to fix.",
    "graphite": {
      "$description": "Night ground. Violet-black (RGB spread 13–30, hue ~255°), not neutral.",
      "100": {
        "$type": "color",
        "$value": "#EFECF7"
      },
      "300": {
        "$type": "color",
        "$value": "#C6BFDB"
      },
      "500": {
        "$type": "color",
        "$value": "#8D85A6",
        "$description": "5.7:1 on bg.base — the floor"
      },
      "600": {
        "$type": "color",
        "$value": "#46396B"
      },
      "700": {
        "$type": "color",
        "$value": "#2C2442"
      },
      "800": {
        "$type": "color",
        "$value": "#251E3A"
      },
      "850": {
        "$type": "color",
        "$value": "#1E1733"
      },
      "900": {
        "$type": "color",
        "$value": "#17122A"
      },
      "950": {
        "$type": "color",
        "$value": "#0D0916"
      },
      "1000": {
        "$type": "color",
        "$value": "#080510"
      }
    },
    "paper": {
      "$description": "Light ground. Lavender (RGB spread 16–45), emphatically not white. `0` is the lightest surface and also the text colour used ON the accent.",
      "0": {
        "$type": "color",
        "$value": "#F1EBFB",
        "$description": "Lightest surface, and the \"on accent\" text colour. Not white."
      },
      "50": {
        "$type": "color",
        "$value": "#E6DEF7",
        "$description": "The page ground."
      },
      "100": {
        "$type": "color",
        "$value": "#DBD0F2"
      },
      "200": {
        "$type": "color",
        "$value": "#CFC2EC"
      },
      "300": {
        "$type": "color",
        "$value": "#C9BBE8"
      },
      "400": {
        "$type": "color",
        "$value": "#A692D6"
      },
      "600": {
        "$type": "color",
        "$value": "#5A5170",
        "$description": "5.7:1 on bg.base — the floor"
      },
      "700": {
        "$type": "color",
        "$value": "#3D3551"
      },
      "900": {
        "$type": "color",
        "$value": "#16101F"
      }
    },
    "violet": {
      "$description": "The brand, reserved for actions. 300 on night at 7.2:1; 800 on light at 6.9:1 — darker than a white-ground theme would need, because the lavender ground is darker than white.",
      "100": {
        "$type": "color",
        "$value": "#D3C2F5"
      },
      "200": {
        "$type": "color",
        "$value": "#C3ABEF"
      },
      "300": {
        "$type": "color",
        "$value": "#A78BFA",
        "$description": "night accent"
      },
      "800": {
        "$type": "color",
        "$value": "#5B21B6",
        "$description": "light accent"
      },
      "900": {
        "$type": "color",
        "$value": "#2A1F4D"
      },
      "950": {
        "$type": "color",
        "$value": "#16102B"
      }
    },
    "gold": {
      "$description": "Means LIVE. The light value sits in a narrow window: dark enough to read on lavender (5.07:1) yet light enough to keep a 1.36 lightness ratio against the dark violet accent. Three steps either way breaks one of the two.",
      "500": {
        "$type": "color",
        "$value": "#F3C84E",
        "$description": "night · 12.4:1"
      },
      "800": {
        "$type": "color",
        "$value": "#75590A",
        "$description": "light · 5.07:1"
      }
    },
    "amber": {
      "500": {
        "$type": "color",
        "$value": "#E0953A",
        "$description": "night · 8.0:1"
      },
      "700": {
        "$type": "color",
        "$value": "#954309",
        "$description": "light · 5.24:1"
      }
    },
    "blue": {
      "$description": "Tertiary fills. Moved off indigo when the accent became violet — the two collided.",
      "300": {
        "$type": "color",
        "$value": "#8AA8F5",
        "$description": "night"
      },
      "500": {
        "$type": "color",
        "$value": "#1B45C4",
        "$description": "light"
      }
    },
    "red": {
      "500": {
        "$type": "color",
        "$value": "#F0564A",
        "$description": "night"
      },
      "700": {
        "$type": "color",
        "$value": "#9E2B22",
        "$description": "light"
      }
    }
  },
  "semantic": {
    "$description": "What a colour is FOR. Components reference only these. Dark is the default theme; light is emitted under a [data-theme] selector.",
    "dark": {
      "$description": "The primary theme.",
      "bg": {
        "base": {
          "$type": "color",
          "$value": "{primitive.graphite.950}"
        },
        "surface": {
          "$type": "color",
          "$value": "{primitive.graphite.900}"
        },
        "raised": {
          "$type": "color",
          "$value": "{primitive.graphite.850}"
        },
        "sunken": {
          "$type": "color",
          "$value": "{primitive.graphite.1000}"
        }
      },
      "text": {
        "primary": {
          "$type": "color",
          "$value": "{primitive.graphite.100}",
          "$description": "~17:1 on bg.base"
        },
        "secondary": {
          "$type": "color",
          "$value": "{primitive.graphite.300}"
        },
        "muted": {
          "$type": "color",
          "$value": "{primitive.graphite.500}",
          "$description": "5.3:1 on bg.base — the floor. Nothing dimmer carries text."
        },
        "onAccent": {
          "$type": "color",
          "$value": "{primitive.violet.950}",
          "$description": "Near-black violet on the accent, 6.8:1."
        }
      },
      "border": {
        "hair": {
          "$type": "color",
          "$value": "{primitive.graphite.700}",
          "$description": "The signature 1px hairline. Default for every panel, row and input."
        },
        "strong": {
          "$type": "color",
          "$value": "{primitive.graphite.600}",
          "$description": "Emphasis only — table heads, focused controls."
        }
      },
      "accent": {
        "default": {
          "$type": "color",
          "$value": "{primitive.violet.300}",
          "$description": "Actions only. 7.2:1 on bg.base."
        },
        "soft": {
          "$type": "color",
          "$value": "{primitive.violet.900}"
        }
      },
      "status": {
        "live": {
          "$type": "color",
          "$value": "{primitive.gold.500}"
        },
        "warn": {
          "$type": "color",
          "$value": "{primitive.amber.500}"
        },
        "error": {
          "$type": "color",
          "$value": "{primitive.red.500}"
        },
        "info": {
          "$type": "color",
          "$value": "{primitive.blue.300}"
        }
      },
      "waveform": {
        "played": {
          "$type": "color",
          "$value": "{primitive.violet.300}"
        },
        "remaining": {
          "$type": "color",
          "$value": "{primitive.graphite.800}"
        }
      }
    },
    "light": {
      "$description": "Secondary theme. Not an inversion: the accent DARKENS to violet.800, and gold, amber and error all move down, because a lavender ground is darker than white and costs contrast.",
      "bg": {
        "base": {
          "$type": "color",
          "$value": "{primitive.paper.50}"
        },
        "surface": {
          "$type": "color",
          "$value": "{primitive.paper.0}"
        },
        "raised": {
          "$type": "color",
          "$value": "{primitive.paper.100}"
        },
        "sunken": {
          "$type": "color",
          "$value": "{primitive.paper.200}"
        }
      },
      "text": {
        "primary": {
          "$type": "color",
          "$value": "{primitive.paper.900}"
        },
        "secondary": {
          "$type": "color",
          "$value": "{primitive.paper.700}"
        },
        "muted": {
          "$type": "color",
          "$value": "{primitive.paper.600}",
          "$description": "5.4:1 on bg.base — the floor."
        },
        "onAccent": {
          "$type": "color",
          "$value": "{primitive.paper.0}",
          "$description": "Pale lavender on violet.800, 7.7:1. Not white."
        }
      },
      "border": {
        "hair": {
          "$type": "color",
          "$value": "{primitive.paper.300}"
        },
        "strong": {
          "$type": "color",
          "$value": "{primitive.paper.400}"
        }
      },
      "accent": {
        "default": {
          "$type": "color",
          "$value": "{primitive.violet.800}"
        },
        "soft": {
          "$type": "color",
          "$value": "{primitive.violet.100}"
        }
      },
      "status": {
        "live": {
          "$type": "color",
          "$value": "{primitive.gold.800}"
        },
        "warn": {
          "$type": "color",
          "$value": "{primitive.amber.700}"
        },
        "error": {
          "$type": "color",
          "$value": "{primitive.red.700}"
        },
        "info": {
          "$type": "color",
          "$value": "{primitive.blue.500}"
        }
      },
      "waveform": {
        "played": {
          "$type": "color",
          "$value": "{primitive.violet.800}"
        },
        "remaining": {
          "$type": "color",
          "$value": "{primitive.paper.300}"
        }
      }
    }
  },
  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": [
          "Inter",
          "system-ui",
          "sans-serif"
        ]
      },
      "mono": {
        "$type": "fontFamily",
        "$value": [
          "JetBrains Mono",
          "ui-monospace",
          "monospace"
        ],
        "$description": "Every number in the product: BPM, key, timecode, milliseconds, LUFS, counts, percentages. Not decoration — tabular figures keep columns aligned and make a changing value legible at a glance."
      }
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "medium": {
        "$type": "fontWeight",
        "$value": 500
      },
      "semibold": {
        "$type": "fontWeight",
        "$value": 600
      },
      "bold": {
        "$type": "fontWeight",
        "$value": 700
      }
    }
  },
  "typography": {
    "display": {
      "lg": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "50px",
          "lineHeight": "1.0",
          "fontWeight": "{font.weight.semibold}",
          "letterSpacing": "-0.035em"
        }
      },
      "md": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "38px",
          "lineHeight": "1.04",
          "fontWeight": "{font.weight.semibold}",
          "letterSpacing": "-0.03em"
        }
      }
    },
    "heading": {
      "lg": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "22px",
          "lineHeight": "1.2",
          "fontWeight": "{font.weight.semibold}",
          "letterSpacing": "-0.025em"
        }
      },
      "md": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "16px",
          "lineHeight": "1.3",
          "fontWeight": "{font.weight.semibold}",
          "letterSpacing": "-0.015em"
        }
      }
    },
    "body": {
      "md": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "13px",
          "lineHeight": "1.55",
          "fontWeight": "{font.weight.regular}",
          "letterSpacing": "0"
        }
      },
      "sm": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.sans}",
          "fontSize": "11.5px",
          "lineHeight": "1.5",
          "fontWeight": "{font.weight.regular}",
          "letterSpacing": "0"
        }
      }
    },
    "data": {
      "$description": "Numeric readouts. Always mono.",
      "lg": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.mono}",
          "fontSize": "20px",
          "lineHeight": "1.1",
          "fontWeight": "{font.weight.bold}",
          "letterSpacing": "0"
        }
      },
      "md": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.mono}",
          "fontSize": "11.5px",
          "lineHeight": "1.3",
          "fontWeight": "{font.weight.regular}",
          "letterSpacing": "0"
        }
      }
    },
    "label": {
      "$description": "Mono micro-labels. 9.5px is only legible because tracking is very wide and they are always uppercase.",
      "md": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{font.family.mono}",
          "fontSize": "9.5px",
          "lineHeight": "1.2",
          "fontWeight": "{font.weight.medium}",
          "letterSpacing": "0.13em",
          "textTransform": "uppercase"
        }
      }
    }
  },
  "space": {
    "1": {
      "$type": "dimension",
      "$value": "4px"
    },
    "2": {
      "$type": "dimension",
      "$value": "8px"
    },
    "3": {
      "$type": "dimension",
      "$value": "12px"
    },
    "4": {
      "$type": "dimension",
      "$value": "16px"
    },
    "5": {
      "$type": "dimension",
      "$value": "20px"
    },
    "6": {
      "$type": "dimension",
      "$value": "24px"
    },
    "8": {
      "$type": "dimension",
      "$value": "32px"
    },
    "10": {
      "$type": "dimension",
      "$value": "40px"
    },
    "12": {
      "$type": "dimension",
      "$value": "48px"
    }
  },
  "radius": {
    "none": {
      "$type": "dimension",
      "$value": "0px"
    },
    "sm": {
      "$type": "dimension",
      "$value": "3px",
      "$description": "The default. Enough to read as a control, not enough to read as a bubble."
    },
    "full": {
      "$type": "dimension",
      "$value": "9999px",
      "$description": "Status dots and the primary transport button only."
    }
  },
  "borderWidth": {
    "hair": {
      "$type": "dimension",
      "$value": "1px",
      "$description": "The signature. If in doubt, 1px."
    },
    "focus": {
      "$type": "dimension",
      "$value": "2px",
      "$description": "Focus rings only."
    }
  },
  "shadow": {
    "$description": "There are no shadows in this system. Depth comes from the ground/surface/raised steps and from hairlines. A box-shadow in a component is a bug."
  },
  "motion": {
    "duration": {
      "fast": {
        "$type": "duration",
        "$value": "120ms"
      },
      "base": {
        "$type": "duration",
        "$value": "200ms"
      }
    },
    "easing": {
      "standard": {
        "$type": "cubicBezier",
        "$value": [
          0.2,
          0,
          0.2,
          1
        ]
      }
    }
  },
  "size": {
    "control": {
      "$type": "dimension",
      "$value": "36px",
      "$description": "Dense controls in the nav and room strip. Sits inside a 44px hit area."
    },
    "touchTarget": {
      "$type": "dimension",
      "$value": "44px",
      "$description": "WCAG 2.1 AA minimum. Every interactive element meets this, by padding where the visual control is smaller."
    }
  }
}
