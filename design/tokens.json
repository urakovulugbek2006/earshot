{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Earshot design tokens. Direction C (Signal). DTCG format — consumed by Style Dictionary to emit Tailwind theme + CSS custom properties, and mirrored as Figma variables. This file is the source of truth; never hardcode a colour in a component.",

  "primitive": {
    "$description": "Raw palette. Never reference these from a component — go through `semantic`.",
    "sand": {
      "50":  { "$type": "color", "$value": "#FDFCFA" },
      "100": { "$type": "color", "$value": "#F5F3EE" },
      "200": { "$type": "color", "$value": "#EDEAE0" },
      "300": { "$type": "color", "$value": "#D6D3CA" },
      "400": { "$type": "color", "$value": "#A8A49A" },
      "600": { "$type": "color", "$value": "#5C5A54" },
      "700": { "$type": "color", "$value": "#413F39" },
      "900": { "$type": "color", "$value": "#1C1B16" },
      "950": { "$type": "color", "$value": "#13120E" },
      "1000":{ "$type": "color", "$value": "#0D0D09" }
    },
    "ink":   { "$type": "color", "$value": "#141413" },
    "white": { "$type": "color", "$value": "#FFFFFF" },
    "blue": {
      "400": { "$type": "color", "$value": "#60A5FA" },
      "600": { "$type": "color", "$value": "#1D4ED8" },
      "700": { "$type": "color", "$value": "#1E3A8A" }
    },
    "lime": {
      "200": { "$type": "color", "$value": "#D9F99D" },
      "500": { "$type": "color", "$value": "#84CC16" }
    },
    "orange": {
      "400": { "$type": "color", "$value": "#FB923C" },
      "600": { "$type": "color", "$value": "#EA580C" }
    },
    "amber": { "200": { "$type": "color", "$value": "#FDE68A" } },
    "sky":   { "200": { "$type": "color", "$value": "#BFDBFE" } }
  },

  "semantic": {
    "$description": "What a colour is FOR. Components reference only these. Each has a light and a dark value; the build emits both under a [data-theme] selector.",

    "light": {
      "bg": {
        "base":    { "$type": "color", "$value": "{primitive.sand.100}", "$description": "Page ground" },
        "surface": { "$type": "color", "$value": "{primitive.white}",    "$description": "Cards, panels, inputs" },
        "sunken":  { "$type": "color", "$value": "{primitive.sand.200}", "$description": "Wells, inset areas" }
      },
      "text": {
        "primary":   { "$type": "color", "$value": "{primitive.ink}",      "$description": "15:1 on bg.base" },
        "secondary": { "$type": "color", "$value": "{primitive.sand.700}", "$description": "8:1 on bg.base" },
        "muted":     { "$type": "color", "$value": "{primitive.sand.600}", "$description": "6.5:1 on bg.base — the floor. Nothing lighter carries text." },
        "onAccent":  { "$type": "color", "$value": "{primitive.white}" },
        "onHighlight": { "$type": "color", "$value": "{primitive.ink}" }
      },
      "border": {
        "strong": { "$type": "color", "$value": "{primitive.ink}",      "$description": "The signature 2px border. Used on nearly every surface." },
        "subtle": { "$type": "color", "$value": "{primitive.sand.300}", "$description": "Dividers only, never a container edge" }
      },
      "accent": {
        "default": { "$type": "color", "$value": "{primitive.blue.600}" },
        "hover":   { "$type": "color", "$value": "{primitive.blue.700}" }
      },
      "status": {
        "highlight": { "$type": "color", "$value": "{primitive.lime.200}", "$description": "In-sync state, live room header" },
        "warn":      { "$type": "color", "$value": "{primitive.orange.600}" }
      },
      "shadow": { "hard": { "$type": "color", "$value": "{primitive.ink}" } },
      "waveform": {
        "played":    { "$type": "color", "$value": "{primitive.blue.600}" },
        "remaining": { "$type": "color", "$value": "{primitive.sand.300}" }
      }
    },

    "dark": {
      "$description": "Not an inversion. The brutalist language is kept by flipping border.strong to a LIGHT value, so 2px edges still read as edges. Accent lightens because blue.600 fails contrast on a dark ground.",
      "bg": {
        "base":    { "$type": "color", "$value": "{primitive.sand.950}" },
        "surface": { "$type": "color", "$value": "{primitive.sand.900}" },
        "sunken":  { "$type": "color", "$value": "{primitive.sand.1000}" }
      },
      "text": {
        "primary":   { "$type": "color", "$value": "{primitive.sand.100}", "$description": "16:1 on bg.base" },
        "secondary": { "$type": "color", "$value": "{primitive.sand.300}" },
        "muted":     { "$type": "color", "$value": "{primitive.sand.400}", "$description": "8:1 on bg.base" },
        "onAccent":  { "$type": "color", "$value": "{primitive.sand.950}", "$description": "Dark text on the lighter accent" },
        "onHighlight": { "$type": "color", "$value": "{primitive.ink}" }
      },
      "border": {
        "strong": { "$type": "color", "$value": "{primitive.sand.200}" },
        "subtle": { "$type": "color", "$value": "#302E26" }
      },
      "accent": {
        "default": { "$type": "color", "$value": "{primitive.blue.400}" },
        "hover":   { "$type": "color", "$value": "#93C5FD" }
      },
      "status": {
        "highlight": { "$type": "color", "$value": "{primitive.lime.200}", "$description": "Unchanged — it carries dark text in both themes" },
        "warn":      { "$type": "color", "$value": "{primitive.orange.400}" }
      },
      "shadow": { "hard": { "$type": "color", "$value": "{primitive.sand.200}" } },
      "waveform": {
        "played":    { "$type": "color", "$value": "{primitive.blue.400}" },
        "remaining": { "$type": "color", "$value": "#302E26" }
      }
    }
  },

  "font": {
    "family": {
      "sans": { "$type": "fontFamily", "$value": ["Archivo", "system-ui", "sans-serif"] }
    },
    "weight": {
      "regular":  { "$type": "fontWeight", "$value": 400 },
      "medium":   { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold":     { "$type": "fontWeight", "$value": 700 },
      "black":    { "$type": "fontWeight", "$value": 800 }
    }
  },

  "typography": {
    "$description": "Named roles, not sizes. A component asks for `display.lg`, never `50px`.",
    "display": {
      "lg": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontSize": "50px", "lineHeight": "0.96", "fontWeight": "{font.weight.black}", "letterSpacing": "-0.035em" } },
      "md": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontSize": "36px", "lineHeight": "1.0",  "fontWeight": "{font.weight.black}", "letterSpacing": "-0.03em" } }
    },
    "heading": {
      "lg": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontSize": "20px",   "lineHeight": "1.2",  "fontWeight": "{font.weight.black}",    "letterSpacing": "-0.02em" } },
      "md": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontSize": "16px",   "lineHeight": "1.3",  "fontWeight": "{font.weight.bold}",     "letterSpacing": "-0.01em" } },
      "sm": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontSize": "14px",   "lineHeight": "1.35", "fontWeight": "{font.weight.semibold}", "letterSpacing": "0" } }
    },
    "body": {
      "lg": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontSize": "16px",   "lineHeight": "1.5",  "fontWeight": "{font.weight.regular}", "letterSpacing": "0" } },
      "md": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontSize": "13.5px", "lineHeight": "1.5",  "fontWeight": "{font.weight.regular}", "letterSpacing": "0" } },
      "sm": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontSize": "12px",   "lineHeight": "1.45", "fontWeight": "{font.weight.regular}", "letterSpacing": "0" } }
    },
    "label": {
      "$description": "Uppercase eyebrow labels. 11px is only legible in this treatment because weight is 700 and tracking is wide — do not reuse the size elsewhere.",
      "md": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontSize": "11px", "lineHeight": "1.2", "fontWeight": "{font.weight.bold}", "letterSpacing": "0.1em", "textTransform": "uppercase" } }
    }
  },

  "space": {
    "$description": "4px base. Use the scale, never an arbitrary pixel value.",
    "0":  { "$type": "dimension", "$value": "0px" },
    "1":  { "$type": "dimension", "$value": "4px" },
    "2":  { "$type": "dimension", "$value": "8px" },
    "3":  { "$type": "dimension", "$value": "12px" },
    "4":  { "$type": "dimension", "$value": "16px" },
    "5":  { "$type": "dimension", "$value": "20px" },
    "6":  { "$type": "dimension", "$value": "24px" },
    "8":  { "$type": "dimension", "$value": "32px" },
    "10": { "$type": "dimension", "$value": "40px" },
    "12": { "$type": "dimension", "$value": "48px" },
    "16": { "$type": "dimension", "$value": "64px" }
  },

  "radius": {
    "$description": "Deliberately tiny set. Direction C is sharp — a rounded corner is an exception, not a default.",
    "none": { "$type": "dimension", "$value": "0px" },
    "sm":   { "$type": "dimension", "$value": "2px" },
    "full": { "$type": "dimension", "$value": "9999px", "$description": "Status dots and avatars only" }
  },

  "borderWidth": {
    "hair":    { "$type": "dimension", "$value": "1px" },
    "default": { "$type": "dimension", "$value": "2px", "$description": "The signature. If in doubt, 2px." },
    "thick":   { "$type": "dimension", "$value": "3px" }
  },

  "shadow": {
    "$description": "Hard offset, zero blur. No soft shadows anywhere in this system — that is the whole visual thesis.",
    "hard": {
      "sm": { "$type": "shadow", "$value": { "offsetX": "4px", "offsetY": "4px", "blur": "0px", "spread": "0px", "color": "{semantic.light.shadow.hard}" } },
      "md": { "$type": "shadow", "$value": { "offsetX": "7px", "offsetY": "7px", "blur": "0px", "spread": "0px", "color": "{semantic.light.shadow.hard}" } }
    }
  },

  "motion": {
    "duration": {
      "fast": { "$type": "duration", "$value": "120ms" },
      "base": { "$type": "duration", "$value": "200ms" },
      "slow": { "$type": "duration", "$value": "320ms" }
    },
    "easing": {
      "standard": { "$type": "cubicBezier", "$value": [0.2, 0, 0.2, 1] },
      "decelerate": { "$type": "cubicBezier", "$value": [0, 0, 0.2, 1] }
    }
  },

  "size": {
    "touchTarget": { "$type": "dimension", "$value": "44px", "$description": "WCAG 2.1 AA minimum. Every interactive element meets this, including icon-only transport buttons." }
  }
}
