{
  "name": "earshot",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "tokens": "pnpm --filter @earshot/tokens build",
    "up": "docker compose up -d",
    "down": "docker compose down"
  },
  "devDependencies": {
    "turbo": "2.3.3",
    "typescript": "5.7.2"
  }
}
